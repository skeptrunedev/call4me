{
  "name": "callbay",
  "private": true,
  "repository": "github:skeptrunedev/callbay",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "check": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply callbay --local",
    "db:migrate:remote": "wrangler d1 migrations apply callbay --remote",
    "deploy": "wrangler deploy",
    "grant": "node scripts/grant-credits.mjs"
  },
  "dependencies": {
    "@better-auth/mcp": "^1.7.6",
    "@better-auth/oauth-provider": "^1.7.6",
    "@modelcontextprotocol/server": "^2.1.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "better-auth": "^1.7.6",
    "hono": "^4.13.9",
    "jose": "^6.2.12",
    "marked": "^18.0.14",
    "marked-footnote": "^1.4.0",
    "stripe": "^22.6.2",
    "worker-mailer": "^1.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.1.0",
    "@types/node": "^26.6.3",
    "auth": "^1.7.6",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "wrangler": "^4.141.0"
  }
}
