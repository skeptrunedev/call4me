{
  "name": "call4me",
  "private": true,
  "repository": "github:skeptrunedev/call4me",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev -c wrangler.jsonc -c wrangler.voice.jsonc",
    "check": "tsc -p tsconfig.json",
    "crawlers": "node scripts/configure-crawlers.mjs",
    "lint": "eslint src",
    "cf-typegen": "wrangler types -c wrangler.jsonc -c wrangler.voice.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply callbay --local",
    "db:migrate:remote": "wrangler d1 migrations apply callbay --remote",
    "deploy": "scripts/deploy-voice.sh && wrangler deploy",
    "grant": "node scripts/grant-credits.mjs",
    "number": "tsx scripts/number.ts",
    "outreach": "node scripts/outreach.mjs",
    "transfer": "node scripts/transfer-credits.mjs",
    "template": "tsx scripts/email-template.ts",
    "recap": "tsx scripts/recap.ts",
    "password-user": "node scripts/create-password-user.mjs",
    "plugin:zip": "rm -f dist/call4me-chatgpt-plugin.zip && mkdir -p dist && cd chatgpt-plugin && zip -qr ../dist/call4me-chatgpt-plugin.zip . -x '*.svg'",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "test:menu:live": "tsx scripts/eval-menu-recovery.ts"
  },
  "dependencies": {
    "@better-auth/mcp": "^1.7.6",
    "@better-auth/oauth-provider": "^1.7.6",
    "@modelcontextprotocol/server": "^2.1.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "better-auth": "^1.7.6",
    "hono": "^4.13.9",
    "jose": "^6.2.12",
    "libphonenumber-js": "^1.13.14",
    "marked": "^18.0.14",
    "marked-footnote": "^1.4.0",
    "raindrop-ai": "^0.8.0",
    "stripe": "^22.6.2",
    "worker-mailer": "^1.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.1.0",
    "@types/node": "^26.6.3",
    "auth": "^1.7.6",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "wrangler": "^4.141.0",
    "ws": "^8.22.0"
  }
}
