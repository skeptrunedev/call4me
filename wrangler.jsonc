{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "callbay",
  "main": "src/server/index.tsx",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Open Graph cards: fonts and the resvg renderer are bundled into the Worker. Blog posts
  // (src/content/blog/*.md) are bundled as text.
  "rules": [
    { "type": "Text", "globs": ["**/*.md"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true },
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }
  ],
  "routes": [
    { "pattern": "call4.me", "custom_domain": true },
    { "pattern": "www.call4.me", "custom_domain": true },
    { "pattern": "callbay.skeptrune.com", "custom_domain": true }
  ],
  // wrangler dev hands the Worker https://call4.me/... as in production; plain http would be
  // redirected to https (lib/context.ts canonicalRedirect).
  "dev": { "upstream_protocol": "https" },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // Everything is server-rendered; only /static/* and the favicon are real assets.
    "run_worker_first": true
  },
  // Every minute: scheduled calls that came due (services/scheduled.ts). Every 15: the sweeps and
  // emails in index.tsx scheduled().
  "triggers": { "crons": ["* * * * *", "*/15 * * * *"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "callbay", "database_id": "34bce7a3-4d5d-46cf-af21-bddecf0c1f93", "migrations_dir": "migrations" }
  ],
  // Call sessions live in the voice Worker (wrangler.voice.jsonc), so deploying the site never
  // resets a live call. They were the CallSession class here until v2.
  "durable_objects": {
    "bindings": [{ "name": "VOICE_SESSION", "class_name": "VoiceSession", "script_name": "call4me-voice" }]
  },
  // Call recaps are logged to Raindrop by the voice Worker (voice/recap-log.ts), which already
  // ships the SDK; bundling it here doubled every cold start.
  "services": [{ "binding": "RECAP_LOG", "service": "call4me-voice", "entrypoint": "RecapLog" }],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CallSession"] },
    { "tag": "v2", "deleted_classes": ["CallSession"] }
  ],
  "vars": {
    "CANONICAL_HOST": "call4.me",
    // The voice Worker's host: Telnyx's media streams attach there (services/dialer.ts streamUrl).
    "VOICE_HOST": "voice.call4.me",
    // IndexNow key (services/indexnow.ts). Public by design: served at /<key>.txt.
    "INDEXNOW_KEY": "3d15f1882b0b7931273db1a9e4f5ef35",
    // OpenAI plugin portal domain challenge, served as plain text at /.well-known/openai-apps-challenge.
    // Public by design.
    "OPENAI_APPS_CHALLENGE": "5uKX5v_XpSSDgUfJ8cE4NFawwb_IOwnV_4gHHelxzbA",
    // Hosts callbay used to live on (comma-separated). Pages there redirect to
    // CANONICAL_HOST, but MCP, OAuth, webhooks and voice keep answering in place:
    // installed agents, issued tokens and provider webhooks still point there.
    "LEGACY_HOSTS": "callbay.skeptrune.com",
    // Signup drip (services/drip.ts): accounts created at or after this time (ms since
    // epoch) get the lifecycle emails. Empty turns the drip off.
    "DRIP_START": "1790575258929",
    // Meta Pixel (lib/meta.ts) and Meta's domain verification tag (views/layout.tsx). Public by
    // design: both are served in every page's head. Server-side events also need META_CAPI_TOKEN.
    "META_PIXEL_ID": "971191426037374",
    "META_DOMAIN_VERIFICATION": "gu3s9uylqgxfi97umjy2w79w97u964",
    // Set the verified Reddit Pixel id here; REDDIT_CAPI_TOKEN is a Worker secret.
    // Acquisition is captured even while delivery is not yet configured.
    "REDDIT_PIXEL_ID": "",
    "REDDIT_INTERNAL_EMAILS": "me@skeptrune.com,nicholas.khami@gmail.com,khamikeira@gmail.com,chatgpt-review@call4.me,claude-review@call4.me",
    "APP_NAME": "call4me",
    // US cents per started minute of talk time.
    "PRICE_PER_MINUTE_CENTS": "25",
    "VOICE_MODEL": "gpt-live-1",
    "BACK_OFFICE_MODEL": "gpt-5.5"
  },
  "observability": { "enabled": true }
}
